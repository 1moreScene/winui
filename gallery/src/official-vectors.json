    "Line": {
      "description": "Draws a straight line between two points.",
      "samples": [
        {
          "title": "Line",
          "xaml": "<Line Stroke=\"SteelBlue\"/>"
        },
        {
          "title": "Polyline",
          "xaml": "<Polyline Stroke=\"Black\"\n          Points=\"10,100 60,40 200,40 250,100\"/>"
        },
        {
          "title": "Path",
          "xaml": "<!-- The first segment is a cubic Bezier curve that begins at Point #1 and ends at Point #4, which is drawn by using Point #2 and 3 as the two control points. This segment is indicated by the \"C\" command in the Data attribute string. -->\n<!-- The second segment begins with an absolute horizontal line command \"H\", which specifies a line drawn from the preceding subpath endpoint (Point #4) to a new endpoint (Point #5). Because it's a horizontal line command, the value specified is an x-coordinate. -->\n                    \n<Path Stroke=\"DarkGoldenRod\"\n      Data=\"M 10,100 C 100,25 300,250 400,75 H 200\"/>"
        },
        {
          "title": "GeometryGroup",
          "xaml": "<Path Stroke=\"Black\" StrokeThickness=\"4\" Fill=\"#CCCCFF\">\n    <Path.Data>\n                    \n        <!-- Creates a composite shape from three geometries. -->\n        <GeometryGroup FillRule=\"EvenOdd\">\n            <LineGeometry StartPoint=\"10,10\" EndPoint=\"50,30\" />\n            <EllipseGeometry Center=\"40,70\" />\n            <RectangleGeometry Rect=\"30,55 100 30\" />\n        </GeometryGroup>\n    </Path.Data>\n</Path>"
        }
      ],

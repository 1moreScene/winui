{
  "description": "Represents icon controls that use different image types as its content.",
  "bitmapDescription": "The ShowAsMonochrome property (true by default) will result in a solid block of the foreground color if the property is set to true and the icon is more than one color. This behavior can be ignored by setting the ShowAsMonochrome property to false.",
  "samples": [
    {
      "title": "A BitmapIcon with a multicolor bitmap image",
      "xaml": "<BitmapIcon x:Name=\"SlicesIcon\" UriSource=\"ms-appx:///Assets/SampleMedia/Slices.png\" Width=\"50\"/>"
    },
    {
      "title": "A FontIcon using a glyph from a specific font family in a button",
      "xaml": "<Button Name=\"ExampleButton1\">\n    <FontIcon FontFamily=\"Segoe MDL2 Assets\" Glyph=\"&#xE790;\"/>\n</Button>"
    },
    {
      "title": "A ImageIcon using a bitmap image in a button",
      "xaml": "<Button Name=\"ImageExample1\" Width=\"100\">\n    <ImageIcon Source=\"/Assets/SampleMedia/slices.png\"/>\n</Button>"
    },
    {
      "title": "A ImageIcon using a SVG image in a button",
      "xaml": "<Button Name=\"ImageExample2\">\n    <ImageIcon Source=\"https://raw.githubusercontent.com/DiemenDesign/LibreICONS/master/svg-color/libre-camera-panorama.svg\" Width=\"50\"/>\n</Button>"
    },
    {
      "title": "A PathIcon in a button",
      "xaml": "<Button Name=\"Example1Button\">\n    <PathIcon Data=\"F1 M 16,12 20,2L 20,16 1,16\" HorizontalAlignment=\"Center\"/>\n</Button>"
    },
    {
      "title": "A SymbolIcon in a button",
      "xaml": "<Button Name=\"AcceptButton\">\n    <StackPanel>\n        <SymbolIcon Symbol=\"Accept\"/>\n        <TextBlock Text=\"Accept\"/>\n    </StackPanel>\n</Button>"
    }
  ],

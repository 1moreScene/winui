{
  "commit": "7360ac322414e118eadfb0c7c2f4ecc31a218f59",
  "controls": {
    "CalendarDatePicker": {
      "description": "A control that lets users pick a date value using a calendar.",
      "samples": [
        {
          "title": "CalendarDatePicker with a header and placeholder text.",
          "xaml": "<CalendarDatePicker PlaceholderText=\"Pick a date\" Header=\"Calendar\" />",
          "code": "",
          "options": []
        }
      ]
    },
    "CalendarView": {
      "description": "CalendarView shows a larger view for showing and selecting dates.  DatePicker by contrast has a compact view with inline selection.",
      "samples": [
        {
          "title": "A basic calendar view.",
          "xaml": "<CalendarView \n    SelectionMode=\"$(SelectionMode)\" \n    IsGroupLabelVisible=\"$(IsGroupLabelVisible)\"\n    IsOutOfScopeEnabled=\"$(IsOutOfScopeEnabled)\"\n    Language=\"$(Language)\"\n    CalendarIdentifier=\"$(CalendarIdentifier)\" />",
          "code": "",
          "options": [
            {
              "kind": "CheckBox",
              "name": "isGroupLabelVisible",
              "label": "IsGroupLabelVisible",
              "checked": true,
              "items": []
            },
            {
              "kind": "CheckBox",
              "name": "isOutOfScopeEnabled",
              "label": "IsOutOfScopeEnabled",
              "checked": true,
              "items": []
            },
            {
              "kind": "ComboBox",
              "name": "selectionMode",
              "label": "SelectionMode",
              "checked": false,
              "items": [
                "None",
                "Single",
                "Multiple"
              ]
            },
            {
              "kind": "ComboBox",
              "name": "calendarIdentifier",
              "label": "CalendarIdentifier",
              "checked": false,
              "items": []
            },
            {
              "kind": "ComboBox",
              "name": "calendarLanguages",
              "label": "Language",
              "checked": false,
              "items": []
            }
          ]
        }
      ]
    },
    "ColorPicker": {
      "description": "A selectable color spectrum.",
      "samples": [
        {
          "title": "ColorPicker Properties.",
          "xaml": "<ColorPicker\n      ColorSpectrumShape=\"$(ColorSpectrumShape)\"\n      IsMoreButtonVisible=\"$(IsMoreButtonVisible)\"\n      IsColorSliderVisible=\"$(IsColorSliderVisible)\"\n      IsColorChannelTextInputVisible=\"$(IsColorChannelTextInputVisible)\"\n      IsHexInputVisible=\"$(IsHexInputVisible)\"\n      IsAlphaEnabled=\"$(IsAlphaEnabled)\"\n      IsAlphaSliderVisible=\"$(IsAlphaSliderVisible)\"\n      IsAlphaTextInputVisible=\"$(IsAlphaTextInputVisible)\" />",
          "code": "",
          "options": [
            {
              "kind": "CheckBox",
              "name": "moreBtn",
              "label": "IsMoreButtonVisible",
              "checked": false,
              "items": []
            },
            {
              "kind": "CheckBox",
              "name": "colorSlider",
              "label": "IsColorSliderVisible",
              "checked": true,
              "items": []
            },
            {
              "kind": "CheckBox",
              "name": "colorChannelInput",
              "label": "IsColorChannelTextInputVisible",
              "checked": true,
              "items": []
            },
            {
              "kind": "CheckBox",
              "name": "hexInput",
              "label": "IsHexInputVisible",
              "checked": true,
              "items": []
            },
            {
              "kind": "CheckBox",
              "name": "alpha",
              "label": "Alpha Enabled",
              "checked": false,
              "items": []
            },
            {
              "kind": "CheckBox",
              "name": "alphaSlider",
              "label": "IsAlphaSliderVisible",
              "checked": true,
              "items": []
            },
            {
              "kind": "CheckBox",
              "name": "alphaTextInput",
              "label": "IsAlphaTextInputVisible",
              "checked": true,
              "items": []
            },
            {
              "kind": "RadioButtons",
              "name": "ColorSpectrumShapeRadioButtons",
              "label": "Colorspectrum shape",
              "checked": false,
              "items": [
                "Box",
                "Ring"
              ]
            }
          ]
        }
      ]
    },
    "DatePicker": {
      "description": "Use a DatePicker to let users set a date in your app, for example to schedule an appointment. The DatePicker displays three controls for month, date, and year. These controls are easy to use with touch or mouse, and they can be styled and configured in several different ways.",
      "samples": [
        {
          "title": "A simple DatePicker with a header.",
          "xaml": "<DatePicker Header=\"Pick a date\" />",
          "code": "",
          "options": []
        },
        {
          "title": "A DatePicker with day formatted and year hidden.",
          "xaml": "<DatePicker DayFormat=\"{}{day.integer} ({dayofweek.abbreviated})\" YearVisible=\"False\" />",
          "code": "",
          "options": []
        }
      ]
    },
    "TimePicker": {
      "description": "Use a TimePicker to let users set a time in your app, for example to set a reminder. The TimePicker displays three controls for hour, minute, and AM/PM. These controls are easy to use with touch or mouse, and they can be styled and configured in several different ways.",
      "samples": [
        {
          "title": "A simple TimePicker that uses the clock format for the user's region.",
          "xaml": "<TimePicker/>",
          "code": "",
          "options": []
        },
        {
          "title": "A TimePicker with a header and minute increments specified.",
          "xaml": "<TimePicker Header=\"Arrival time\" MinuteIncrement=\"15\" />",
          "code": "",
          "options": []
        },
        {
          "title": "Use ClockIdentifier to override the regional clock format.",
          "xaml": "<StackPanel xmlns:sys=\"using:System\" Spacing=\"8\">\n    <TimePicker ClockIdentifier=\"12HourClock\" Header=\"12-hour clock\" SelectedTime=\"{x:Bind sys:DateTime.Now.TimeOfDay}\" />\n    <TimePicker ClockIdentifier=\"24HourClock\" Header=\"24-hour clock\" SelectedTime=\"{x:Bind sys:DateTime.Now.TimeOfDay}\" />\n</StackPanel>",
          "code": "",
          "options": []
        }
      ]
    }
  },

{
  "controls": {
    "InfoBar": {
      "description": "Use an InfoBar control when a user should be informed of, acknowledge, or take action on a changed application state. By default the notification will remain in the content area until closed by the user but will not necessarily break user flow.",
      "samples": [
        {
          "title": "A closable InfoBar with options to change its Severity.",
          "xaml": "<InfoBar \n    IsOpen=\"{x:Bind TestInfoBar1.IsOpen, Mode=TwoWay}\"\n    Title=\"Title\"\n    Message=\"Essential app message for your users to be informed of, acknowledge, or take action on.\" />"
        },
        {
          "title": "A closable InfoBar with a long or short message and various buttons",
          "xaml": "<InfoBar \n    IsOpen=\"{x:Bind TestInfoBar2.IsOpen, Mode=TwoWay}\"\n    Title=\"Title\"\n    Message=\"\" >\n    \n</InfoBar>"
        },
        {
          "title": "A closable InfoBar with options to display the close button and icon",
          "xaml": "<InfoBar \n    IsOpen=\"{x:Bind TestInfoBar3.IsOpen, Mode=TwoWay}\"\n    IsIconVisible=\"{x:Bind TestInfoBar3.IsIconVisible, Mode=TwoWay}\"                    \n    IsClosable=\"{x:Bind TestInfoBar3.IsClosable, Mode=TwoWay}\"\n    Title=\"Title\"\n    Message=\"Essential app message for your users to be informed of, acknowledge, or take action on.\" />"
        }
      ]
    },
    "PersonPicture": {
      "description": "Displays the picture of a person/contact.",
      "samples": [
        {
          "title": "Select different looks for the person picture.",
          "xaml": "<PersonPicture ProfilePicture=\"https://learn.microsoft.com/windows/uwp/contacts-and-calendar/images/shoulder-tap-static-payload.png\" />"
        }
      ]
    },
    "RatingControl": {
      "description": "Rate something 1 to 5 stars.",
      "samples": [
        {
          "title": "A simple RatingControl",
          "xaml": "<RatingControl AutomationProperties.Name=\"Simple RatingControl\" Caption=\"312 ratings\"/>"
        },
        {
          "title": "PlaceholderValue of RatingControl",
          "xaml": "<RatingControl AutomationProperties.Name=\"RatingControl with placeholder\" />"
        }
      ]
    },
    "SplitButton": {
      "description": "The SplitButton is a dropdown button, but with an addition execution hit target.",
      "samples": [
        {
          "title": "A SplitButton controlling text color in a RichEditBox",
          "xaml": "<SplitButton x:Name=\"myColorButton\" Click=\"myColorButton_Click\">\n    <Border x:Name=\"CurrentColor\" Width=\"32\" Height=\"32\" Background=\"Green\" CornerRadius=\"4,0,0,4\"/>\n    <SplitButton.Flyout>\n        <Flyout Placement=\"Bottom\">\n            <!-- flyout content -->\n        </Flyout>\n    </SplitButton.Flyout>\n</SplitButton>"
        },
        {
          "title": "A SplitButton with text",
          "xaml": "<SplitButton x:Name=\"myColorButton\">\n    Choose color\n    <SplitButton.Flyout>\n        <Flyout Placement=\"Bottom\">\n            <!-- flyout content -->\n        </Flyout>\n    </SplitButton.Flyout>\n</SplitButton>"
        }
      ]
    },
    "ToggleSplitButton": {
      "description": "A version of the SplitButton where the activation target toggles on/off.",
      "samples": [
        {
          "title": "Using ToggleSplitButton to control bulleted list functionality in RichEditBox",
          "xaml": "<ToggleSplitButton x:Name=\"myListButton\" VerticalAlignment=\"Top\" Click=\"myListButton_Click\">\n    <SymbolIcon x:Name=\"mySymbolIcon\" Symbol=\"List\"/>\n    <ToggleSplitButton.Flyout>\n        <Flyout Placement=\"Bottom\">\n            <!-- flyout content -->\n        </Flyout>\n    </ToggleSplitButton.Flyout>\n</ToggleSplitButton>"
        }
      ]
    }
  },

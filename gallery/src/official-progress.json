{
  "galleryCommit": "7360ac322414e118eadfb0c7c2f4ecc31a218f59",
  "controls": {
    "ProgressBar": {
      "description": "The ProgressBar has two different visual representations:\nIndeterminate - shows that a task is ongoing, but doesn't block user interaction.\nDeterminate - shows how much progress has been made on a known amount of work.",
      "samples": [
        {
          "title": "An indeterminate progress bar.",
          "file": "IndeterminateProgressBar.txt",
          "xaml": "<ProgressBar Width=\"130\" IsIndeterminate=\"True\" />"
        },
        {
          "title": "A determinate progress bar.",
          "file": "DeterminateProgressBar.txt",
          "xaml": "<ProgressBar Width=\"130\" />"
        }
      ]
    },
    "ProgressRing": {
      "description": "The ProgressRing has two different visual representations:\nIndeterminate - shows that a task is ongoing, but blocks user interaction.\nDeterminate - shows how much progress has been made on a known amount of work.",
      "samples": [
        {
          "title": "An indeterminate progress ring.",
          "file": "IndeterminateProgressRing.txt",
          "xaml": "<ProgressRing IsActive=\"True\" Background=\"LightGray\"/>"
        },
        {
          "title": "A determinate progress ring.",
          "file": "DeterminateProgressRing.txt",
          "xaml": "<ProgressRing Width=\"60\" Height=\"60\"\n              IsIndeterminate=\"False\"\n              Background=\"LightGray\"/>"
        }
      ]
    }
  },

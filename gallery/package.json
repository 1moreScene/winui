{
  "name": "winui-wasm-gallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "node ../tools/build-wasm.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:wasm && tsc --noEmit && vite build && npm run declarations",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:home": "playwright test -c playwright.home.config.ts",
    "declarations": "tsc -p tsconfig.sdk.json && node ../tools/copy-sdk-types.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
